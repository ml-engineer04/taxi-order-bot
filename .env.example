# Telegram Bot API Configuration
# Get your BOT_TOKEN from https://t.me/BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Comma-separated list of numeric Telegram User IDs for Administrators
# Find your ID using https://t.me/userinfobot
ADMIN_USER_IDS=123456789,987654321

# Administrator username shown to drivers for manual payments (without @)
ADMIN_USERNAME=taxi_admin

# Target Telegram Groups (IDs: -100..., Usernames: @group, or Invite links: https://t.me/+...)
PUBLIC_GROUP_ID=-1001234567890, @toshkent_taxi, https://t.me/+AbCdEf
PRIVATE_GROUP_ID=0

# Cooldown: skip repeated messages from the same user for 24 hours (1 day)
USER_COOLDOWN_HOURS=24

# Forwarding Mode: "copy" (recommended for privacy/deep linking) or "forward"
FORWARD_MODE=copy

# Telegram Userbot (MTProto) for joining restricted passenger groups
USERBOT_ENABLED=false
TG_API_ID=
TG_API_HASH=
USERBOT_SESSION_NAME=data/userbot.session

# Database Configuration
# Local development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./taxi_bot.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/taxi_bot

# Application Timezone
TIMEZONE=Asia/Tashkent

# Subscription Defaults
DEFAULT_SUBSCRIPTION_DAYS=30

# Classifier Settings
CLASSIFIER_TYPE=ml
ML_MODEL_PATH=app/ml/models/taxi_classifier.joblib
CLASSIFIER_CONFIDENCE_THRESHOLD=0.65
ENABLE_LLM_CLASSIFIER=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
